<?xml version="1.0" encoding="utf-8"?>
<!--
  BootLockActivity layout — lightweight loading screen shown immediately after boot.
  Locks the device in lock-task mode BEFORE React Native loads, preventing the
  "reboot dodges lock" vulnerability on slow devices (#98).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rc_background">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="48dp"
        android:src="@drawable/rc_terminal"
        android:scaleType="centerInside"
        android:contentDescription="@string/app_name" />

    <ProgressBar
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/rc_accent" />
</FrameLayout>
